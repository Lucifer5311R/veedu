{
  "manifest_version": 3,
  "name": "Veedu Importer",
  "version": "1.2",
  "description": "Import Meesho products to your Veedu store with one click",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.meesho.com/*/p/*", "*://meesho.com/*/p/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.vercel.app/admin*", "http://localhost:3000/admin*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["tabs", "storage"],
  "host_permissions": ["*://*.vercel.app/*", "http://localhost:3000/*", "*://*.meesho.com/*"]
}
